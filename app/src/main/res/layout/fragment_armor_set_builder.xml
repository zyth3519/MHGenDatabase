<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color">

    <!-- Filter Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:elevation="2dp"
        app:cardCornerRadius="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <!-- Row 1: Gender + Type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    style="@style/text_small"
                    android:text="性别" />

                <Spinner
                    android:id="@+id/spinner_gender"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/margin_large"
                    android:entries="@array/gender_values"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    style="@style/text_small"
                    android:text="类型" />

                <Spinner
                    android:id="@+id/spinner_type"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:entries="@array/hunter_type_filter"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

            </LinearLayout>

            <!-- Row 2: Rarity + Slots -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/margin_small">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    style="@style/text_small"
                    android:text="稀有度" />

                <Spinner
                    android:id="@+id/spinner_rarity"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/margin_large"
                    android:entries="@array/rarity_values"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    style="@style/text_small"
                    android:text="孔位" />

                <Spinner
                    android:id="@+id/spinner_slots"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:entries="@array/slot_filter_values"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

            </LinearLayout>

            <!-- Row 2: Defense Range -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/margin_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/text_small"
                    android:text="防御力"
                    android:minWidth="48dp"/>

                <EditText
                    android:id="@+id/edit_defense_min"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="最低"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/margin_small" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/text_small"
                    android:text="~"
                    android:minWidth="16dp"
                    android:gravity="center"/>

                <EditText
                    android:id="@+id/edit_defense_max"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="最高"
                    android:maxLines="1" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Skills Section Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/margin_medium"
        android:paddingEnd="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_small">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/text_medium"
            android:text="技能筛选" />

        <TextView
            android:id="@+id/text_selected_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/text_small_secondary"
            tools:text="已选 0" />

    </LinearLayout>

    <!-- Skill Filter Input -->
    <EditText
        android:id="@+id/edit_skill_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="搜索技能..."
        android:maxLines="1"
        android:inputType="textFilter"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_small"
        android:padding="@dimen/margin_medium"
        android:background="@android:drawable/edit_text"
        style="@style/text_medium" />

    <!-- Skills RecyclerView (fixed height) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_skills"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_small"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/margin_medium"
        tools:listitem="@layout/item_skill_filter" />

    <!-- Search Button -->
    <Button
        android:id="@+id/button_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:text="搜索套装"
        style="@style/ButtonStyle" />

</LinearLayout>
